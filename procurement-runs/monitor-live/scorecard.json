{
  "id": "monitor-office-2026-live",
  "name": "办公显示器评分卡（实盘）",
  "category": "显示器",
  "version": "1.0",
  "rationale": "办公场景优先保证预算内、27 英寸 2K 与可开票；面板与保修次之。价格权重 0.35 因为同规格池内价差可达一倍，且预算已由硬过滤限定在 1500 以内；保修 0.15 因为 4 台统一采购的售后集中度高于单台；升降支架只是加分项，给 0.10 而不设为硬条件。",
  "enrichment_targets": ["price", "detail.warranty", "detail.invoice", "detail.stock_status", "attributes.stand"],
  "hard_filters": [
    {
      "id": "budget",
      "label": "单台预算",
      "field": "landed_price.floor",
      "op": "lte",
      "value_from": "budget_per_unit_cny",
      "missing": "review",
      "reason": "到手价下限不得超过单台 1500 元"
    },
    {
      "id": "used",
      "label": "排除二手/翻新",
      "field": "title",
      "op": "not_contains_any",
      "value": ["二手", "翻新", "官翻"],
      "missing": "pass",
      "reason": "必须全新品"
    },
    {
      "id": "ad",
      "label": "排除广告位",
      "field": "flags.ad",
      "op": "eq",
      "value": false,
      "missing": "pass",
      "reason": "广告位不是自然搜索结果"
    },
    {
      "id": "screen",
      "label": "27 英寸及以上",
      "field": "attributes.screen_inch",
      "op": "gte",
      "value": 27,
      "missing": "review",
      "reason": "屏幕尺寸未确认时需人工复核"
    },
    {
      "id": "resolution",
      "label": "2K 分辨率",
      "field": "attributes.resolution",
      "op": "contains_any",
      "value": ["2K", "2560", "1440"],
      "missing": "review",
      "reason": "分辨率未确认时需人工复核"
    },
    {
      "id": "invoice",
      "label": "可开发票",
      "field": "detail.invoice",
      "op": "contains_any",
      "value": ["发票"],
      "missing": "review",
      "reason": "企业采购需要发票；页面没写不等于不能开，转人工确认"
    }
  ],
  "dimensions": [
    {
      "id": "price",
      "label": "价格",
      "weight": 0.35,
      "method": "minmax",
      "field": "landed_price.floor",
      "direction": "lower_better",
      "missing": "worst"
    },
    {
      "id": "panel",
      "label": "面板",
      "weight": 0.2,
      "method": "keyword",
      "field": "attributes.panel",
      "rules": [
        {"any": ["IPS"], "score": 5, "label": "IPS"},
        {"any": ["VA"], "score": 3, "label": "VA"}
      ],
      "default": 2,
      "missing": "worst"
    },
    {
      "id": "ergonomics",
      "label": "支架调节",
      "weight": 0.1,
      "method": "keyword",
      "field": "attributes.stand",
      "rules": [
        {"any": ["旋转升降", "升降旋转"], "score": 5, "label": "旋转升降"},
        {"any": ["升降"], "score": 4, "label": "可升降"},
        {"any": ["普通"], "score": 2, "label": "固定支架"}
      ],
      "default": 2,
      "missing": "neutral"
    },
    {
      "id": "warranty",
      "label": "保修",
      "weight": 0.15,
      "method": "keyword",
      "field": "detail.warranty",
      "rules": [
        {"any": ["3年", "三年"], "score": 5, "label": "3 年"},
        {"any": ["2年", "两年"], "score": 3, "label": "2 年"},
        {"any": ["1年", "一年"], "score": 2, "label": "1 年"}
      ],
      "default": 1,
      "missing": "worst"
    },
    {
      "id": "invoice",
      "label": "发票",
      "weight": 0.1,
      "method": "keyword",
      "field": "detail.invoice",
      "rules": [
        {"any": ["专用发票"], "score": 5, "label": "专票"},
        {"any": ["普通发票"], "score": 4, "label": "普票"},
        {"any": ["发票"], "score": 3, "label": "票种未明"}
      ],
      "default": 0,
      "missing": "worst"
    },
    {
      "id": "seller",
      "label": "渠道",
      "weight": 0.1,
      "method": "keyword",
      "field": "shop_name",
      "rules": [
        {"any": ["自营"], "score": 5, "label": "自营"},
        {"any": ["官方旗舰店", "官方直营"], "score": 4, "label": "官方店"},
        {"any": ["旗舰店"], "score": 3, "label": "旗舰店"}
      ],
      "default": 2,
      "missing": "worst"
    }
  ],
  "confidence": {"weight_coverage_min": 0.7, "penalize_missing": true}
}
