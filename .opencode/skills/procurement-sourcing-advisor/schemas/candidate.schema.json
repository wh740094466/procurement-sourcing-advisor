{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.procurement/schemas/candidate.schema.json",
  "title": "Normalized Procurement Candidate",
  "type": "object",
  "required": [
    "platform",
    "product_id",
    "listing_id",
    "variant_id",
    "variant_label",
    "title",
    "model",
    "price_status",
    "currency",
    "shop_name",
    "sales",
    "url",
    "detail",
    "reviews",
    "fetched_at",
    "confidence"
  ],
  "properties": {
    "platform": {"enum": ["taobao", "jd"]},
    "product_id": {"type": "string", "minLength": 1},
    "listing_id": {"type": "string", "minLength": 1},
    "listing_title": {"type": "string"},
    "variant_id": {"type": "string", "minLength": 1},
    "variant_label": {"type": "string", "minLength": 1},
    "option_path": {"type": "array", "items": {"type": "string"}},
    "title": {"type": "string", "minLength": 1},
    "model": {"type": "string"},
    "price": {"type": ["number", "null"], "minimum": 0},
    "price_status": {"enum": ["visible", "hidden", "unknown"]},
    "price_anchor": {"type": ["object", "null"]},
    "price_ratio": {"type": ["number", "null"]},
    "price_anomaly": {"type": "boolean"},
    "currency": {"const": "CNY"},
    "orig_price": {"type": ["number", "null"]},
    "shop_name": {"type": "string"},
    "sales": {"type": ["string", "number", "null"]},
    "url": {"type": "string"},
    "detail": {
      "type": "object",
      "required": ["specs", "warranty", "invoice", "stock_status"],
      "properties": {
        "specs": {"type": "string"},
        "warranty": {"type": "string"},
        "invoice": {"type": "string"},
        "stock_status": {"type": "string"},
        "browser_specs_excerpt": {"type": "string"}
      },
      "additionalProperties": true
    },
    "attributes": {"type": "object"},
    "official": {
      "type": "object",
      "description": "Matched manufacturer official page used to fill missing technical specs. Never a price source.",
      "properties": {
        "manufacturer": {"type": "string"},
        "model": {"type": "string"},
        "region": {"type": "string"},
        "url": {"type": "string"},
        "captured_at": {"type": "string"},
        "match_status": {"enum": ["exact", "family", "not_found"]},
        "matched_text": {"type": "string"},
        "specs": {"type": "object"},
        "filled_attributes": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "object"}},
        "notes": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "reviews": {
      "type": "object",
      "required": ["status", "sample_size"],
      "properties": {
        "status": {"enum": ["ok", "missing"]},
        "rating": {"type": ["number", "null"]},
        "positive_rate": {"type": ["number", "null"]},
        "rating_count": {"type": ["integer", "null"]},
        "sample_size": {"type": "integer", "minimum": 0},
        "negative_rate": {"type": ["number", "null"]},
        "negative_themes": {"type": "array", "items": {"type": "object"}},
        "positive_themes": {"type": "array", "items": {"type": "object"}},
        "evidence": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "fetched_at": {"type": "string"},
    "detail_fetched_at": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "price_note": {"type": "string"},
    "flags": {"type": "object"},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "browser_evidence": {"type": "array", "items": {"type": "object"}},
    "price_observations": {"type": "array", "items": {"type": "object"}},
    "sources": {"type": "array", "items": {"type": "object"}},
    "manual_scores": {"type": "object"},
    "missing_fields": {"type": "array", "items": {"type": "string"}},
    "needs_review": {"type": "boolean"},
    "needs_user_action": {"type": "boolean"},
    "enrichment_status": {"type": "string"},
    "landed_price": {"type": "object"},
    "tco": {"type": "object"},
    "score": {"type": "number"},
    "score_confidence": {"type": "number"},
    "score_breakdown": {"type": "array", "items": {"type": "object"}},
    "eligible": {"type": "boolean"},
    "rank": {"type": ["integer", "null"], "minimum": 1}
  },
  "additionalProperties": true
}
