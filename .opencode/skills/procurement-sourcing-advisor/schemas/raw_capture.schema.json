{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.procurement/schemas/raw_capture.schema.json",
  "title": "Raw Browser Capture (listing + variants + reviews + official specs)",
  "description": "Output of the AI + playwright-mcp collection stage. A listing is only a container; every variant (SKU/configuration) is a separate candidate downstream. Every price and every review theme must carry a verbatim snippet. Optional manufacturer-page blocks supply technical specs only, never prices.",
  "type": "object",
  "required": ["captures"],
  "additionalProperties": true,
  "properties": {
    "captures": {
      "type": "array",
      "minItems": 0,
      "items": {"$ref": "#/$defs/capture"}
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "stage", "message"],
        "properties": {
          "platform": {"enum": ["taobao", "jd"]},
          "listing_id": {"type": ["string", "null"]},
          "stage": {"enum": ["search", "listing", "variants", "reviews", "official", "navigation"]},
          "message": {"type": "string"},
          "url": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "capture": {
      "type": "object",
      "required": ["platform", "listing_id", "url", "title", "captured_at", "page_state", "variants"],
      "additionalProperties": true,
      "properties": {
        "platform": {"enum": ["taobao", "jd"]},
        "listing_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "shop": {"type": "string"},
        "shop_type": {"type": "string"},
        "sales": {"type": ["string", "number", "null"]},
        "ad": {"type": "boolean", "description": "True when the listing carried an ad badge; ad slots are excluded."},
        "captured_at": {"type": "string", "minLength": 10},
        "page_state": {"enum": ["ok", "login_required", "captcha", "blocked"]},
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/variant"}
        },
        "sections": {"$ref": "#/$defs/sections"},
        "official": {"$ref": "#/$defs/official_source"},
        "aborted": {"type": "boolean", "description": "True when collection stopped early because the listing hit a brief exclusion."},
        "abort_reason": {"type": "string"},
        "reviews": {"$ref": "#/$defs/reviews"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "variant": {
      "type": "object",
      "required": ["label", "option_path", "evidence"],
      "additionalProperties": true,
      "properties": {
        "variant_id": {"type": "string"},
        "label": {"type": "string", "minLength": 1},
        "option_path": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "Human-readable option chain actually selected, e.g. ['27英寸','2K','多功能支架']."
        },
        "price": {"type": ["number", "string", "null"]},
        "price_text": {"type": "string"},
        "price_status": {"enum": ["visible", "hidden", "unknown"]},
        "list_price": {"type": ["number", "string", "null"]},
        "stock_status": {"type": "string"},
        "promo_text": {"type": "string"},
        "specs": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number", "null"]}
        },
        "official": {
          "$ref": "#/$defs/official_source",
          "description": "Variant-specific manufacturer page. Takes precedence over capture.official when both exist."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": true,
      "description": "Extra page sections worth keeping: parameter table, after-sales terms, usage notes, shop info, Q&A, recommendations.",
      "properties": {
        "params": {"type": "object", "additionalProperties": {"type": ["string", "number", "null"]}},
        "after_sales": {"type": "string"},
        "usage": {"type": "string"},
        "shop": {"type": "object", "additionalProperties": true},
        "qa": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "question": {"type": "string"},
              "answer": {"type": "string"}
            }
          }
        },
        "recommendations": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Related products shown on the page. Reference only; never becomes a candidate."
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reviews": {
      "type": "object",
      "required": ["sample_size", "evidence"],
      "additionalProperties": true,
      "properties": {
        "rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
        "rating_count": {"type": ["integer", "null"], "minimum": 0},
        "sample_size": {"type": "integer", "minimum": 0},
        "negative_themes": {
          "type": "array",
          "items": {"$ref": "#/$defs/theme"}
        },
        "positive_themes": {
          "type": "array",
          "items": {"$ref": "#/$defs/theme"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "official_source": {
      "type": "object",
      "description": "Manufacturer official product/spec page. Supplies technical specifications only; never price, stock, or promotion.",
      "required": ["manufacturer", "model", "url", "captured_at", "match_status"],
      "additionalProperties": true,
      "properties": {
        "manufacturer": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "region": {"type": "string", "description": "Region/edition of the official page, e.g. CN or global. Exact specs may differ by region."},
        "url": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "minLength": 10},
        "match_status": {"enum": ["exact", "family", "not_found"]},
        "matched_text": {"type": "string", "description": "Verbatim official-page text that contains the exact model/part number."},
        "specs": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number", "null"]}
        },
        "notes": {"type": "array", "items": {"type": "string"}},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"match_status": {"const": "exact"}},
            "required": ["match_status"]
          },
          "then": {
            "required": ["matched_text", "specs", "evidence"],
            "properties": {
              "matched_text": {"type": "string", "minLength": 1},
              "specs": {"type": "object", "minProperties": 1},
              "evidence": {"type": "array", "minItems": 1}
            }
          }
        }
      ]
    },
    "theme": {
      "type": "object",
      "required": ["theme", "count"],
      "additionalProperties": true,
      "properties": {
        "theme": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1},
        "snippets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["field", "snippet", "source_url"],
      "additionalProperties": true,
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "null"]},
        "snippet": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
